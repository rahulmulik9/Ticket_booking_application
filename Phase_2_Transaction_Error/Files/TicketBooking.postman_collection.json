{
  "info": {
    "name": "Ticket Booking - Phase 2",
    "description": "Phase 2: transactions, custom exceptions, global error handling, validation. Run the Setup folder first, then Bookings in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup (run first)",
      "item": [
        {
          "name": "1. Create movie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Inception\",\n  \"language\": \"English\",\n  \"durationMinutes\": 148\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('movieId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Create show (generates 50 seats)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/shows",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shows"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movieId\": \"{{movieId}}\",\n  \"startTime\": \"2026-10-20T18:30:00\",\n  \"price\": 250.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('showId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Get seats of show (saves first two seat ids)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/shows/{{showId}}/seats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shows",
                "{{showId}}",
                "seats"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var seats = pm.response.json();",
                  "pm.collectionVariables.set('seatId1', seats[0].id);",
                  "pm.collectionVariables.set('seatId2', seats[1].id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "1. Valid booking (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showId\": \"{{showId}}\",\n  \"userId\": 1,\n  \"seatIds\": [\n    \"{{seatId1}}\",\n    \"{{seatId2}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "var b = pm.response.json();",
                  "pm.collectionVariables.set('bookingId', b.id);",
                  "pm.test('Booking is CONFIRMED', function () { pm.expect(b.status).to.eql('CONFIRMED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Validation error (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showId\": null,\n  \"seatIds\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Error body has status 400', function () { pm.expect(pm.response.json().status).to.eql(400); });",
                  "pm.test('Message check', function () { pm.expect(pm.response.json().message).to.include(\"seatIds must not be empty\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Seat already taken (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showId\": \"{{showId}}\",\n  \"userId\": 1,\n  \"seatIds\": [\n    \"{{seatId1}}\",\n    \"{{seatId2}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', function () { pm.response.to.have.status(409); });",
                  "pm.test('Error body has status 409', function () { pm.expect(pm.response.json().status).to.eql(409); });",
                  "pm.test('Message check', function () { pm.expect(pm.response.json().message).to.include(\"already booked\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Seat not in this show (404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showId\": \"{{showId}}\",\n  \"userId\": 1,\n  \"seatIds\": [\n    999999\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });",
                  "pm.test('Error body has status 404', function () { pm.expect(pm.response.json().status).to.eql(404); });",
                  "pm.test('Message check', function () { pm.expect(pm.response.json().message).to.include(\"do not exist for show\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Show not found (404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showId\": 999999,\n  \"userId\": 1,\n  \"seatIds\": [\n    \"{{seatId1}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {

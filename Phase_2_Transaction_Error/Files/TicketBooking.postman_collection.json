              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });",
                  "pm.test('Error body has status 404', function () { pm.expect(pm.response.json().status).to.eql(404); });",
                  "pm.test('Message check', function () { pm.expect(pm.response.json().message).to.include(\"Booking not found\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "9. Cancel booking (200)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}",
                "cancel"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Booking is CANCELLED', function () { pm.expect(pm.response.json().status).to.eql('CANCELLED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "10. Cancel again (409)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}",
                "cancel"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', function () { pm.response.to.have.status(409); });",
                  "pm.test('Error body has status 409', function () { pm.expect(pm.response.json().status).to.eql(409); });",
                  "pm.test('Message check', function () { pm.expect(pm.response.json().message).to.include(\"already cancelled\"); });"
                ]
              }
            }

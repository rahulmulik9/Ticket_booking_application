                  "pm.test('Message check', function () { pm.expect(pm.response.json().message).to.include(\"Show not found\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Malformed body (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"showId\": 1,",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Error body has status 400', function () { pm.expect(pm.response.json().status).to.eql(400); });",
                  "pm.test('Message check', function () { pm.expect(pm.response.json().message).to.include(\"malformed\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Get booking (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Booking not found (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [

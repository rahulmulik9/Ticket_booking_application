{
  "info": {
    "name": "Ticket Booking - Phase 5 (core)",
    "description": "Ticket Booking API, Phase 5: the important requests only.\n\nHOW TO RUN\n1. Start the app with the dev profile (DevDataSeeder creates organizer@example.com and admin@example.com, password Secret123).\n2. Run the folders in order. Tokens and ids are saved into collection variables by the test scripts.\nRe-running is safe: registration accepts 201 or 409, and each run creates a new movie and show.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register user A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice User\",\n  \"email\": \"{{userAEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 created, or 409 if already registered\", function () { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });",
                  "if (pm.response.code === 201) {",
                  "  const b = pm.response.json();",
                  "  pm.test(\"role is USER\", function () { pm.expect(b.role).to.eql(\"USER\"); });",
                  "  pm.test(\"no password or hash in response\", function () { pm.expect(b).to.not.have.property(\"password\"); pm.expect(b).to.not.have.property(\"passwordHash\"); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register user B",
          "request": {
            "method": "POST",
            "header": [
              {

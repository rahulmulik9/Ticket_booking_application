                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// one week from now, so the start time is always in the future",
                  "const t = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString().slice(0, 19);",
                  "pm.collectionVariables.set(\"startTime\", t);"
                ]
              }

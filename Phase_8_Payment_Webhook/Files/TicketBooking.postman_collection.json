                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{organizerEmail}}\",\n  \"password\": \"{{organizerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "pm.test(\"has access and refresh token\", function () { pm.expect(b.accessToken).to.be.a(\"string\"); pm.expect(b.refreshToken).to.be.a(\"string\"); pm.expect(b.tokenType).to.eql(\"Bearer\"); });",
                  "pm.collectionVariables.set(\"organizerToken\", b.accessToken);",
                  "const part = b.accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "const claims = JSON.parse(atob(part));",
                  "pm.test(\"token role is ORGANIZER\", function () { pm.expect(claims.role).to.eql(\"ORGANIZER\"); });"
                ]
              }
            }
          ]
        },

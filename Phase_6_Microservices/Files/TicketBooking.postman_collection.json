        {
          "name": "Login organizer (seeded in dev)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{organizerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "pm.test(\"has access and refresh token\", function () { pm.expect(b.accessToken).to.be.a(\"string\"); pm.expect(b.refreshToken).to.be.a(\"string\"); pm.expect(b.tokenType).to.eql(\"Bearer\"); });",
                  "pm.collectionVariables.set(\"organizerToken\", b.accessToken);",
                  "pm.collectionVariables.set(\"organizerRefreshToken\", b.refreshToken);",
                  "const part = b.accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "const claims = JSON.parse(atob(part));",
                  "pm.collectionVariables.set(\"organizerId\", String(claims.sub));",
                  "pm.collectionVariables.set(\"organizerIdRole\", claims.role);"
                ]
              }
            }
          ]
        },
